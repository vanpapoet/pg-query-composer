{
  "name": "pg-query-composer",
  "version": "1.1.0",
  "description": "Advanced PostgreSQL query builder with dynamic composition, subqueries, and relations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./composition": {
      "types": "./dist/composition/index.d.ts",
      "default": "./dist/composition/index.js"
    },
    "./subquery": {
      "types": "./dist/subquery/index.d.ts",
      "default": "./dist/subquery/index.js"
    },
    "./relations": {
      "types": "./dist/relations/index.d.ts",
      "default": "./dist/relations/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./pg": {
      "types": "./dist/pg/index.d.ts",
      "default": "./dist/pg/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src tests benchmarks",
    "lint:fix": "oxlint src tests benchmarks --fix"
  },
  "dependencies": {
    "dataloader": "^2.2.0"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "oxlint": "^1.78.0",
    "pg": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^3.23.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanpapoet/pg-query-composer.git"
  },
  "homepage": "https://github.com/vanpapoet/pg-query-composer#readme",
  "bugs": {
    "url": "https://github.com/vanpapoet/pg-query-composer/issues"
  },
  "author": "vanpapoet",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "postgresql",
    "query-builder",
    "sql",
    "typescript",
    "where-clause",
    "dynamic-query",
    "node-postgres",
    "pg",
    "subquery",
    "composition"
  ],
  "license": "MIT"
}
